---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoBlock from '../components/InfoBlock.astro';
import {
  informacionGeneral,
  mision,
  vision,
  historia,
  valoresInstitucionales,
  politicaDeCalidad,
  unionTemporalMaisfen,
} from '../data/valoresInstitucionales';
import Info from '@/components/Info.astro';
---

<BaseLayout
  title="Nosotros"
  description="Sociedad Clínica Emcosalud: institución prestadora de servicios de salud (IPS) privada, misión, visión, historia y valores institucionales."
>
  <Info eyebrow="Nosotros" title="Sociedad Clínica Emcosalud" description="Institución Prestadora de Servicios de Salud (IPS)" compact />

  <InfoBlock eyebrow="Quiénes somos" title="Información general">
    <ul class="grid gap-4 sm:grid-cols-2">
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-wide text-brand-600">Ubicación</p>
        <p class="mt-1 text-sm text-slate-600">{informacionGeneral.ubicacion}</p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-wide text-brand-600">Tipo de entidad</p>
        <p class="mt-1 text-sm text-slate-600">{informacionGeneral.tipoEntidad}</p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-wide text-brand-600">Servicios</p>
        <p class="mt-1 text-sm text-slate-600">{informacionGeneral.servicios}</p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-wide text-brand-600">Vinculación</p>
        <p class="mt-1 text-sm text-slate-600">{informacionGeneral.vinculacion}</p>
      </li>
    </ul>
  </InfoBlock>

  <InfoBlock class="bg-brand-50/40">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h3 class="text-lg font-bold text-slate-900">Misión</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{mision}</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h3 class="text-lg font-bold text-slate-900">Visión</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{vision}</p>
      </div>
    </div>
  </InfoBlock>

  <InfoBlock eyebrow="Nuestra trayectoria" title="Historia">
    <p class="max-w-3xl">{historia}</p>
  </InfoBlock>

  <InfoBlock eyebrow="Lo que nos define" title="Valores institucionales" class="bg-brand-50/40">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {
        valoresInstitucionales.map((valor) => (
          <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-700 shadow-sm">
            {valor}
          </div>
        ))
      }
    </div>
    <blockquote class="mt-8 rounded-2xl border-l-4 border-brand-600 bg-white p-6 text-sm italic leading-relaxed text-slate-600 shadow-sm">
      «{politicaDeCalidad}»
      <footer class="mt-2 not-italic text-xs font-bold uppercase tracking-wide text-brand-600">Política de calidad</footer>
    </blockquote>
  </InfoBlock>

  <InfoBlock eyebrow="Alianza" title="Unión Temporal MAISFEN">
    <p class="max-w-3xl">{unionTemporalMaisfen}</p>
  </InfoBlock>
</BaseLayout>
