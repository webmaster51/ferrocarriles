---
import BaseLayout from '../layouts/BaseLayout.astro';
import Info from '../components/Info.astro';
import InfoBlock from '../components/InfoBlock.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import CardLink from '../components/CardLink.astro';
import { site } from '../data/site';
import Hero  from '@/components/sections/Hero.astro';
import Popup from '@/components/react/Popup';

const testimonios = [
  { id: 'XXZtB78ueIw', title: 'Testimonio de usuario Emcosalud 1' },
  { id: 'jS9ivkQQOp0', title: 'Testimonio de usuario Emcosalud 2' },
  { id: 'G6YouqJNKrI', title: 'Testimonio de usuario Emcosalud 3' },
];
// Slug registrado en el CMS
const PORTAL_SLUG = 'ferrocarriles';

let activePopup = null;

try {
  // Petición apuntando a la API pública v1 enviando el slug y el path obligatorios
  const response = await fetch(`http://localhost:4321/api/v1/popups?portal=${PORTAL_SLUG}&path=/`, {
    headers: {
      'X-Portal-Slug': PORTAL_SLUG,
    },
  });

  if (response.ok) {
    const result = await response.json();

    // publicRoute envuelve la respuesta dentro de la clave 'data'
    if (result.data && result.data.length > 0) {
      activePopup = result.data[0];
    }
  }
} catch (error) {
  console.error('Error al obtener el popup desde la API pública:', error);
}
---

<BaseLayout title={site.name} description={site.description}>
  <Hero />
  <Info
    eyebrow="¿Quiénes somos?"
    title="Cuidamos la salud de la familia ferroviaria colombiana"
    description="Somos una empresa especializada en brindar servicios de salud a los usuarios de ferrocarriles nacionales. Esta unión es vital para garantizar el mejor servicio de salud a nuestros usuarios."
    primaryCta={{ label: 'Conoce nuestras sedes', href: '/services/' }}
    secondaryCta={{ label: 'Solicitar cita', href: '/citas/' }}
  />


  <section class="bg-brand-800 py-16 text-white sm:py-20">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="mb-3 inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-100">
          Transformando vidas
        </p>
        <h2 class="text-3xl text-white sm:text-4xl">Tu salud, nuestra prioridad</h2>
        <p class="mt-5 text-lg leading-relaxed text-brand-100">
          Transformando vidas a través de la excelencia en la atención médica. Descubre en Emcosalud una amplia gama
          de servicios de salud de calidad superior, diseñados para tu bienestar integral.
        </p>
        <a href="/services/" class="mt-7 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-brand-800 shadow-sm hover:bg-brand-50">
          Ver más
        </a>
      </div>
      <VideoEmbed youtubeId="R_iPcUHcQTY" title="Transformando vidas — Sociedad Clínica Emcosalud" class="lg:aspect-[4/3]" />
    </div>
  </section>

  <InfoBlock eyebrow="Testimonios" title="Historias que nos inspiran a seguir mejorando">
    <p class="max-w-2xl">
      Nos complace observar los resultados positivos de nuestros servicios, tal como se reflejan en la satisfacción
      de nuestros usuarios.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {testimonios.map((video) => <VideoEmbed youtubeId={video.id} title={video.title} />)}
    </div>
  </InfoBlock>
  
  <InfoBlock eyebrow="Canales de comunicación" title="Conoce nuestros canales y servicios" class="bg-brand-50/40">
    <p class="max-w-2xl">Conoce fácilmente nuestros canales de comunicación y los servicios que tenemos para ti.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <CardLink title="Nuestras sedes" description="Consulta horarios, contactos y ubicación de cada sede de atención." href="/services/" />
      <CardLink title="Mejoremos Juntos (SIAU)" description="Radica peticiones, quejas, reclamos, sugerencias, denuncias o felicitaciones." href="/mejoremos-juntos/" />
      <CardLink title="Contacto" description="Encuentra todos nuestros teléfonos, correos y canales de atención." href="/contact/" />
    </div>
  </InfoBlock>

  {/* Renderizado del popup pasando la frecuencia leída desde la API */}
  {activePopup && (
    <Popup 
      client:load 
      id={activePopup.id.toString()}
      title={activePopup.title || activePopup.internal_name} 
      content={activePopup.description || activePopup.content}
      imageUrl={activePopup.imageUrl}
      linkUrl={activePopup.url}
      ctaText={activePopup.buttonText || activePopup.ctaText}
      frequency={activePopup.frequency}
    />
  )}
</BaseLayout>
