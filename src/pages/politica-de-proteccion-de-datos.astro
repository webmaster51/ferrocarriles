---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoBlock from '../components/InfoBlock.astro';
import { pdfs } from '../data/pdfs';
import Info from '@/components/Info.astro';
---

<BaseLayout
  title="Política de Protección de Datos"
  description="Política de protección de datos personales y autorización para el tratamiento de datos — Grupo Emcosalud."
>
  <Info eyebrow="Artículo 15, Constitución Política de Colombia" title="Protección de datos personales" compact />

  <InfoBlock>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h3 class="text-lg font-bold text-slate-900">Política de protección de datos personales</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          La Ley 1581 de 2012 desarrolló este derecho constitucional conocido como habeas data, que confiere a los
          ciudadanos la posibilidad de decidir y controlar la información que otros poseen sobre ellos.
        </p>
        <a href={pdfs.politicaTratamientoDatos} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-brand-200 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">
          Leer todo
        </a>
      </div>

      <div class="rounded-2xl border border-brand-200 bg-brand-0 p-6 text-white sm:p-8">
        <h3 class="text-lg font-bold text-white">Autorización para el tratamiento de datos</h3>
        <p class="mt-3 text-sm leading-relaxed text-white">
          Con la firma de este documento el usuario manifiesta haber sido informado por el Grupo Empresarial
          Emcosalud y sus empresas subordinadas sobre el tratamiento que se dará a sus datos personales.
        </p>
        <a href={pdfs.formatoAutorizacionDatos} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-brand-200 px-5 py-2.5 text-sm font-semibold text-brand-800 hover:bg-brand-50">
          Leer todo
        </a>
      </div>
    </div>
  </InfoBlock>
</BaseLayout>
