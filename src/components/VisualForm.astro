---
import FormField from './FormField.astro';
import type { FormFieldDef } from '../data/forms/types';

interface Props {
  fields: FormFieldDef[];
  submitLabel?: string;
}

const { fields, submitLabel = 'Enviar' } = Astro.props;
---

<form class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    {fields.map((field) => <FormField field={field} />)}
  </div>

  <!--
    TODO: este formulario es solo maqueta visual (decisión confirmada con el
    cliente). Para conectar el envío real: cambiar type="button" -> "submit",
    añadir action/method (p. ej. un endpoint de Formspree) y quitar `disabled`.
  -->
  <button
    type="button"
    disabled
    aria-disabled="true"
    class="mt-6 inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-xl bg-slate-300 px-6 py-3 text-sm font-semibold text-slate-600 sm:w-auto"
    title="Formulario en modo de vista previa — envío aún no habilitado"
  >
    {submitLabel}
  </button>
  <p class="mt-3 text-xs text-slate-400">Este formulario está en modo de vista previa; el envío se habilitará próximamente.</p>
</form>
