---
import FormField from './FormField.astro';
import type { FormFieldDef } from '../data/forms/types';

interface Props {
  fields: FormFieldDef[];
  submitLabel?: string;
  formType: 'pqrs' | 'cita';
}

const { fields, submitLabel = 'Enviar', formType } = Astro.props;
---

<form data-form-type={formType} class="resend-form rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <input type="hidden" name="formType" value={formType} />

  <div class="grid gap-5 sm:grid-cols-2">
    {fields.map((field) => <FormField field={field} />)}
  </div>

  <button
    type="submit"
    class="submit-btn mt-6 inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-700 disabled:opacity-50 sm:w-auto"
  >
    {submitLabel}
  </button>

  <p class="form-status mt-3 text-xs hidden"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.resend-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector<HTMLButtonElement>('.submit-btn');
      const statusText = form.querySelector<HTMLParagraphElement>('.form-status');

      if (!submitBtn || !statusText) return;

      submitBtn.disabled = true;
      statusText.textContent = 'Enviando solicitud y archivos...';
      statusText.className = 'form-status mt-3 text-xs text-slate-500 block';

      // 1. Capturamos el formulario completo de forma nativa (incluye textos y archivos binarios)
      const formData = new FormData(form);

      try {
        const response = await fetch('/api/send-email', {
          method: 'POST',
          // ⚠️ IMPORTANTE: No incluyas 'Content-Type'. 
          // Al enviar 'body: formData' directamente, el navegador configura 
          // automáticamente el formato multipart/form-data necesario para los archivos.
          body: formData,
        });

        const result = await response.json();

        if (response.ok && result.success) {
          statusText.textContent = '¡Mensaje enviado con éxito!';
          statusText.className = 'form-status mt-3 text-xs text-green-600 font-medium block';
          form.reset();
        } else {
          throw new Error(result.error || 'Error al enviar');
        }
      } catch (err: any) {
        statusText.textContent = err.message || 'Ocurrió un error. Intenta de nuevo.';
        statusText.className = 'form-status mt-3 text-xs text-red-600 font-medium block';
      } finally {
        submitBtn.disabled = false;
      }
    });
  });
</script>