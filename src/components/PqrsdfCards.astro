---
import { pqrsdfCards } from '../data/pqrsdf';
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    pqrsdfCards.map((card) => (
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 text-base font-extrabold text-white">
          {card.letra}
        </span>
        <h3 class="mt-4 text-base font-bold text-slate-900">{card.titulo}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">{card.descripcion}</p>
      </div>
    ))
  }
</div>
