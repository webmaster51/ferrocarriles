---
interface CTA {
  label: string;
  href: string;
};

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
  imageSrc?: string;
  compact?: boolean;
}

const {
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  imageSrc = '/images/placeholders/UPS-BOGOTA.JPG',
  compact = false,
} = Astro.props;
---

<section class:list={['relative overflow-hidden bg-white', compact ? 'py-14 sm:py-16' : 'py-16 sm:py-24']}>
  <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div class={compact ? 'max-w-2xl' : 'max-w-xl'}>
      {eyebrow && (
        <p class="mb-3 inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-700">
          {eyebrow}
        </p>
      )}
      <h1 class:list={['text-slate-900', compact ? 'text-3xl sm:text-4xl' : 'text-4xl sm:text-5xl']}>{title}</h1>
      {description && <p class="mt-5 text-lg leading-relaxed text-slate-600">{description}</p>}

      {(primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {primaryCta && (
            <a href={primaryCta.href} class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700">
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-brand-200 hover:text-brand-700">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )}

      <slot />
    </div>

    {!compact && (
      <div class="relative">
        <div class="aspect-[4/3] overflow-hidden rounded-2xl shadow-md">
          <img src={imageSrc} alt="" class="h-full w-full object-cover" width="800" height="600" loading="eager" />
        </div>
      </div>
    )}
  </div>
</section>
