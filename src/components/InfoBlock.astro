---
interface Props {
  title?: string;
  eyebrow?: string;
  class?: string;
}

const { title, eyebrow, class: className = '' } = Astro.props;
---

<section class:list={['py-10 sm:py-12', className]}>
  <div class="container-page">
    {eyebrow && <p class="mb-2 text-xs font-bold uppercase tracking-wide text-brand-600">{eyebrow}</p>}
    {title && <h2 class="mb-6 text-2xl sm:text-3xl">{title}</h2>}
    <div class="prose-emco max-w-none text-slate-600">
      <slot />
    </div>
  </div>
</section>
