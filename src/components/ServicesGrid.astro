---
import {
  Stethoscope, HeartPulse, Activity, Users, Droplet, Heart, WavesHorizontal, Sparkles, LifeBuoy, Dna, Baby,
  Wind, Brain, Apple, FaceSlightlySmiling, Bone, Ear, BrainCircuit, BrainCog, Droplets, Syringe, TestTube, Pill,
  HandHeart, Mic, TestTubes, FaceSlightlySmilingPlus, HandHelping,
} from '@lucide/astro';
import { services } from '../data/services';

const iconMap: Record<string, any> = {
  Stethoscope, HeartPulse, Activity, Users, Droplet, Heart, Waves: WavesHorizontal, Sparkles, LifeBuoy, Dna, Baby,
  Wind, Brain, Apple, Smile: FaceSlightlySmiling, Bone, Ear, BrainCircuit, BrainCog, Droplets, Syringe, TestTube, Pill,
  HandHeart, Mic, TestTubes, SmilePlus: FaceSlightlySmilingPlus, HandHelping,
};
---

<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {
    services.map((service) => {
      const Icon = iconMap[service.icon] ?? Stethoscope;
      return (
        <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3.5 shadow-sm transition-colors hover:border-brand-200">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
            <Icon size={20} stroke-width={2} />
          </span>
          <span class="text-sm font-semibold text-slate-700">{service.name}</span>
        </div>
      );
    })
  }
</div>
