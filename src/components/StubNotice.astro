---
interface Props {
  message: string;
}

const { message } = Astro.props;
---

<div class="mx-auto flex max-w-xl flex-col items-center rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm">
  <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 text-brand-600">
    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <path d="M12 8v4M12 16h.01" />
    </svg>
  </span>
  <p class="mt-4 text-base leading-relaxed text-slate-600">{message}</p>
  <a href="/" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">
    Volver al inicio
  </a>
</div>
