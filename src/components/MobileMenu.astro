---
// Menú móvil sin JavaScript: usa la técnica del "checkbox hack" (input
// oculto + <label> + selectores CSS peer-checked) para que la navegación
// funcione igual con JS deshabilitado, manteniendo el JS de cliente al mínimo.
import type { NavItem } from '../data/site';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<div class="md:hidden">
  <input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" aria-hidden="true" />

  <label
    for="mobile-menu-toggle"
    class="relative z-20 flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-brand-700 transition-colors hover:bg-brand-50"
    aria-controls="mobile-menu-panel"
    aria-expanded="false"
    role="button"
    tabindex="0"
  >
    <span class="sr-only">Abrir menú de navegación</span>
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </label>

  <div
    id="mobile-menu-panel"
    class="fixed inset-x-0 top-16 z-10 max-h-0 overflow-hidden border-t border-slate-200 bg-white shadow-lg transition-[max-height] duration-300 ease-in-out peer-checked:max-h-[28rem]"
  >
    <nav class="container-page flex flex-col gap-1 py-4">
      {
        items.map((item) => (
          <a href={item.href} class="rounded-xl px-4 py-3 text-base font-semibold text-slate-700 hover:bg-brand-50 hover:text-brand-700">
            {item.label}
          </a>
        ))
      }
      <a href="/citas/" class="mt-2 rounded-xl bg-brand-600 px-4 py-3 text-center text-base font-semibold text-white hover:bg-brand-700">
        Solicitar cita
      </a>
    </nav>
  </div>
</div>
